# =============================================================================
# BRACK — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# --- Application ---
BRACK_ENV=development
BRACK_BASE_URL=http://localhost:3000
BRACK_API_URL=http://localhost:8000
BRACK_SECRET_KEY=change-me-to-a-very-long-random-secret-key-at-least-64-chars
BRACK_JWT_SECRET=change-me-to-another-very-long-random-secret-key-for-jwt-tokens
BRACK_JWT_ALGORITHM=HS256
BRACK_JWT_EXPIRE_MINUTES=10080

# --- Database ---
POSTGRES_USER=brack
POSTGRES_PASSWORD=brackpassword
POSTGRES_DB=brack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brack:brackpassword@postgres:5432/brack

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
BRACK_STORAGE_PATH=/data/brack/repos
BRACK_UPLOAD_MAX_MB=100

# --- AI (Phase 3) ---
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=

# --- CORS ---
BRACK_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Rate Limiting ---
BRACK_RATE_LIMIT_PER_MINUTE=100

# --- Security ---
BRACK_ALLOW_REGISTRATION=true
BRACK_REQUIRE_EMAIL_VERIFICATION=false

# --- Logging ---
LOG_LEVEL=INFO
